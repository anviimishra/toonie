# Copy this file to .env.local and fill in the blanks.
# Never commit .env.local.

# Supabase (public, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://boxskjwwcauwtntmvkdz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_G-o7UplbMC22RHaPKoaSmg_jId7hnSO

# Supabase secret key (server only). Dashboard > Project Settings > API Keys
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# xAI / Grok (server only). Speech-to-text, story script, and panel images.
XAI_API_KEY=xai-your_key_here

# Model overrides. The defaults below are what the code uses; set these only
# to pin a different version.
# XAI_TEXT_MODEL=grok-4.20-0309-non-reasoning
# XAI_IMAGE_MODEL=grok-imagine-image-2.0
# XAI_TRANSCRIBE_MODEL=grok-voice-transcribe-2.0

# Read-alouds on the child's tablet (optional; the app runs without them).
# Gemini translates the story: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.8-flash
# ElevenLabs speaks it in the parent's cloned voice (only after they opt in).
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_MODEL=eleven_multilingual_v2
